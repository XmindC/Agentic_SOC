# Agentic SOC environment file.
# Copy to .env, fill in every <PLACEHOLDER>, then: chmod 600 .env
# .env is git-ignored. Never commit it, paste it into chat, or put a value on a command line.
# install.sh refuses to run while any value still contains "<".

# ---------- Lab addressing: your own private subnets and VM addresses (none are shipped in the repo) ----------
LAB_LAN_CIDR=<LAB_LAN_CIDR>            # protected segment behind OPNsense (vmnet2)
LAB_INFRA_CIDR=<LAB_INFRA_CIDR>       # VMware NAT segment with the SOC tooling
OPNSENSE_WAN_IP=<OPNSENSE_WAN_IP>
OPNSENSE_LAN_IP=<OPNSENSE_LAN_IP>
WAZUH_IP=<WAZUH_IP>
SERVICES_IP=<SERVICES_IP>            # Docker host: n8n, TheHive, Cortex
VICTIM_IP=<VICTIM_IP>
ATTACKER_IP=<ATTACKER_IP>           # authorised Kali test machine

# ---------- Versions (pin; bump deliberately) ----------
WAZUH_VERSION=4.14
THEHIVE_IMAGE=strangebee/thehive:5.2
CORTEX_IMAGE=thehiveproject/cortex:4.1.0-1
CASSANDRA_IMAGE=cassandra:4.1
ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.15.3
N8N_IMAGE=docker.n8n.io/n8nio/n8n:<N8N_VERSION>
DOCKERPROXY_IMAGE=tecnativa/docker-socket-proxy:0.3.0

# ---------- Service secrets (install.sh generates the two session secrets if left as GENERATE) ----------
THEHIVE_SECRET=GENERATE
CORTEX_SECRET=GENERATE
ELASTICSEARCH_HEAP=1g
CASSANDRA_HEAP=1024M

# ---------- API keys (enter in the service UIs where possible; listed here for the CLI agents) ----------
OPENAI_API_KEY=<OPENAI_API_KEY>       # used by agents/l2-investigation; n8n keeps its own copy in its credential store
N8N_API_KEY=<N8N_API_KEY>             # optional: scripts that read the workflow over the n8n API
THEHIVE_API_KEY=<THEHIVE_API_KEY>     # optional: lets the L2 agent post its proposal as a case comment

# ---------- Wazuh indexer read-only user (see docs/05-configuration/readonly-indexer-user.md) ----------
WAZUH_INDEXER_USER=<WAZUH_INDEXER_RO_USER>
WAZUH_INDEXER_PASS=<WAZUH_INDEXER_RO_PASSWORD>

# ---------- Notifications ----------
ALERT_EMAIL=<ALERT_EMAIL>             # escalation emails; the SMTP app password is typed into n8n only

# ---------- Zeek sensor ----------
ZEEK_INTERFACE=ens37                  # the victim01 NIC on LAB_LAN_CIDR
